# s69d: pause sweep — A tap at idle (START proven = quit-to-title in s69a).
WAIT_RAM16 0xFF0244 0x0034
WAIT_RAM16 0xFF1506 0x0160
WAIT 30
HOLD START
WAIT_RAM16 0xFF0244 0x0001
RELEASE
WAIT_RAM16 0xFF0632 0x0000
WAIT 120
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s69d\idle.bin
PRESS A 3
WAIT 100
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s69d\p1.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s69d\p1.png
WAIT 120
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s69d\p2.bin
PRESS A 3
WAIT 100
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s69d\r1.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s69d\r1.png
EXIT