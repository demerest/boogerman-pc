# s68 clean pause re-validation (TITLE_ASSIST OFF): entry, settle idle on the
# ground, then a 40f START press to pause; two dumps 120f apart must be identical
# in the object/camera region; resume dump must show the anim ticker advance.
WAIT_RAM16 0xFF0244 0x0034
WAIT_RAM16 0xFF1506 0x0160
WAIT 30
HOLD START
WAIT_RAM16 0xFF0244 0x0001
RELEASE
WAIT_RAM16 0xFF0632 0x0000
WAIT 60
PRESS START 40
WAIT 120
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s68g\pause1.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s68g\pause1.png
WAIT 120
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s68g\pause2.bin
PRESS START 40
WAIT 120
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s68g\resume.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s68g\resume.png
EXIT
