# s84c: kill the slope-base spitter (bush ~0510-0530, bubbles arc onto plat1
# landing zone; 00372C contact = death coroutine 00A1F6) with grounded flicks
# in range BEFORE the 04E0 boost. Then land, RELEASE, stand, walk to edge.
WAIT_RAM16 0xFF0244 0x0034
WAIT_RAM16 0xFF1506 0x0160
WAIT 300
HOLD START
WAIT_RAM16 0xFF0254 0x0001
RELEASE
WAIT 400
PRESS DOWN 4
WAIT_RAM16 0xFF0244 0x0003
WAIT_RAM16 0xFF0244 0x0010
WAIT 800
HOLD RIGHT
WAIT_RAM16_GE 0xFF0698 0x0480
PRESS A 6
WAIT_RAM16_GE 0xFF0698 0x04A0
PRESS A 6
WAIT_RAM16_GE 0xFF0698 0x04C8
PRESS A 6
WAIT_RAM16_GE 0xFF0698 0x04E0
PRESS B 8
WAIT 6
PRESS DOWN 6
WAIT 24
RELEASE
WAIT 60
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s84c\p1.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s84c\p1.png
WAIT 120
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s84c\p2.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s84c\p2.png
HOLD RIGHT
WAIT 60
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s84c\p3.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s84c\p3.png
