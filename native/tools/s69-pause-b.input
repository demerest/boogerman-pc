# s69b: pause sweep — B tap at idle (START proven = quit-to-title in s69a).
WAIT_RAM16 0xFF0244 0x0034
WAIT_RAM16 0xFF1506 0x0160
WAIT 30
HOLD START
WAIT_RAM16 0xFF0244 0x0001
RELEASE
WAIT_RAM16 0xFF0632 0x0000
WAIT 120
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s69b\idle.bin
PRESS B 3
WAIT 100
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s69b\p1.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s69b\p1.png
WAIT 120
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s69b\p2.bin
PRESS B 3
WAIT 100
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s69b\r1.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s69b\r1.png
EXIT