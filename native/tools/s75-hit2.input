DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s75n4\t2.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s75n4\t2.png
WAIT 120
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s75n4\t3.bin
SCREENSHOT S:\home\dev\boogerman-pc\native\captures-us\s75n4\t3.png
WAIT 300
DUMP_RAM S:\home\dev\boogerman-pc\native\captures-us\s75n4\t4.bin
